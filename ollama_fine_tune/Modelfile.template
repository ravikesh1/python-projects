# Ollama Modelfile Template
# Replace {gguf_path} with your exported GGUF file path
# Replace {system_prompt} with your custom system prompt
#
# Usage: ollama create my-model -f Modelfile

FROM {gguf_path}

# Inference parameters — tune these for your use case
PARAMETER temperature 0.7
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER num_ctx 2048
PARAMETER repeat_penalty 1.1
PARAMETER stop "<|eot_id|>"

# System prompt — defines the model's personality and role
SYSTEM """{system_prompt}"""

# Template — match the base model's chat format
# Llama 3 format (uncomment if using Llama 3):
# TEMPLATE """<|begin_of_text|><|start_header_id|>system<|end_header_id|>
# {{ .System }}<|eot_id|><|start_header_id|>user<|end_header_id|>
# {{ .Prompt }}<|eot_id|><|start_header_id|>assistant<|end_header_id|>
# {{ .Response }}<|eot_id|>"""
