# Modelfile for importing your fine-tuned model into Ollama
#
# After exporting with export_gguf.py, update the FROM path below
# and run:
#   ollama create my-pdf-model -f Modelfile.example
#
# Then use it:
#   ollama run my-pdf-model
#   -- or in the RAG system --
#   OLLAMA_MODEL=my-pdf-model streamlit run app.py

FROM ./model_gguf/unsloth.Q4_K_M.gguf

PARAMETER temperature 0.3
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER repeat_penalty 1.1

SYSTEM """You are a specialized document analyst. When given context from PDF documents:
- Answer based strictly on the provided context
- Cite the specific section or page when possible
- If the context is insufficient, say so clearly
- Use precise, professional language
- Structure longer responses with bullet points
"""

TEMPLATE """{{ if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|>{{ end }}{{ if .Prompt }}<|start_header_id|>user<|end_header_id|>

{{ .Prompt }}<|eot_id|>{{ end }}<|start_header_id|>assistant<|end_header_id|>

{{ .Response }}<|eot_id|>"""
