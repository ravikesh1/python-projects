# Ollama connection
OLLAMA_BASE_URL=http://localhost:11434

# Default LLM model (any model pulled in Ollama)
OLLAMA_MODEL=llama3.2

# Embedding model
OLLAMA_EMBED_MODEL=nomic-embed-text

# Text splitting
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ChromaDB
CHROMA_COLLECTION=pdf_documents
CHROMA_PERSIST_DIR=./chroma_data
