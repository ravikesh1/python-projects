MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CHARSET=utf8mb4

# Set to true to expose the write_query tool (INSERT/UPDATE/DELETE/REPLACE)
MYSQL_ALLOW_WRITE=false

# Set to true to expose the execute_ddl tool (CREATE/ALTER/DROP/TRUNCATE/RENAME)
MYSQL_ALLOW_DDL=false

# Cap the number of rows returned per query
MYSQL_ROW_LIMIT=1000

LOG_LEVEL=INFO

# --- Slack Claude agent ---
# Bot token (OAuth & Permissions page, starts with xoxb-)
SLACK_BOT_TOKEN=
# App-level token with connections:write scope (starts with xapp-)
SLACK_APP_TOKEN=
# Anthropic API key (https://platform.claude.com)
ANTHROPIC_API_KEY=
# Optional overrides
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MAX_TOKENS=16000
