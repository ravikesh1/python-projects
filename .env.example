MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CHARSET=utf8mb4

# Set to true to expose the write_query tool (INSERT/UPDATE/DELETE/REPLACE)
MYSQL_ALLOW_WRITE=false

# Set to true to expose the execute_ddl tool (CREATE/ALTER/DROP/TRUNCATE/RENAME)
MYSQL_ALLOW_DDL=false

# Cap the number of rows returned per query
MYSQL_ROW_LIMIT=1000

LOG_LEVEL=INFO

# --- AI Knowledge Agent ("Batcomputer") ---------------------------------
# Where the local knowledge base (SQLite) lives.
KNOWLEDGE_DB_PATH=~/.ai_knowledge_agent/knowledge.db
# Default number of web-search results / knowledge-base hits.
KNOWLEDGE_SEARCH_MAX_RESULTS=5
# Maximum characters of extracted text stored per ingested page.
KNOWLEDGE_INGEST_MAX_CHARS=50000
# HTTP request timeout (seconds) when fetching pages.
KNOWLEDGE_REQUEST_TIMEOUT=30
# Claude model used by the standalone CLI agent.
KNOWLEDGE_MODEL=claude-opus-4-8

# Required ONLY for the standalone CLI agent (ai-knowledge-agent), not the MCP server.
ANTHROPIC_API_KEY=
