MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CHARSET=utf8mb4

# Set to true to expose the write_query tool (INSERT/UPDATE/DELETE/REPLACE)
MYSQL_ALLOW_WRITE=false

# Set to true to expose the execute_ddl tool (CREATE/ALTER/DROP/TRUNCATE/RENAME)
MYSQL_ALLOW_DDL=false

# Cap the number of rows returned per query
MYSQL_ROW_LIMIT=1000

LOG_LEVEL=INFO

# Gas Tracker: API key from https://collectapi.com/api/gasPrice (free tier)
# for area average prices (Canadian cities, US city/state). Optional — without
# it, prices are limited to stations with OSM price tags.
COLLECTAPI_KEY=
