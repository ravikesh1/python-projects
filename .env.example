MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CHARSET=utf8mb4

# Set to true to expose the write_query tool (INSERT/UPDATE/DELETE/REPLACE)
MYSQL_ALLOW_WRITE=false

# Set to true to expose the execute_ddl tool (CREATE/ALTER/DROP/TRUNCATE/RENAME)
MYSQL_ALLOW_DDL=false

# Cap the number of rows returned per query
MYSQL_ROW_LIMIT=1000

# Set to true to append a JSONL audit record for every tool call
# (arguments, outcome, anomaly flag) to MYSQL_AUDIT_LOG_PATH. Calls are never
# blocked by this -- unexpected argument keys are always logged as a warning
# and, when this is enabled, flagged anomalous=true in the audit record.
MYSQL_AUDIT_LOG=false

# Path to the audit log file (created if missing). Only used when
# MYSQL_AUDIT_LOG=true.
MYSQL_AUDIT_LOG_PATH=logs/mcp-mysql-audit.jsonl

LOG_LEVEL=INFO
