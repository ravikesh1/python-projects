MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CHARSET=utf8mb4

# Set to true to expose the write_query tool (INSERT/UPDATE/DELETE/REPLACE)
MYSQL_ALLOW_WRITE=false

# Set to true to expose the execute_ddl tool (CREATE/ALTER/DROP/TRUNCATE/RENAME)
MYSQL_ALLOW_DDL=false

# Cap the number of rows returned per query
MYSQL_ROW_LIMIT=1000

LOG_LEVEL=INFO

# ── mcp-db-schemas server ──
# JSON array of datasource configs. Each entry needs "name" and "type".
# Supported types: "mysql", "sqlite"
#
# MySQL datasource keys: host, port, user, password, database, charset
# SQLite datasource keys: path
#
# Example:
# DATASOURCES='[{"name":"ecommerce","type":"mysql","host":"127.0.0.1","port":3306,"user":"root","password":"","database":"shop"},{"name":"mood_app","type":"sqlite","path":"mood_task_health_app/app.db"}]'
DATASOURCES=[]
